;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c37" value="Toca «¿Olvidaste tu contraseña?»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;T06 · Recuperar contraseña" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c39" value="Toca «Enviar enlace»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;T07 · Revisa tu correo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c41" value="Abre el enlace del correo" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;T08 · Nueva contraseña" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c43" value="Escribe y confirma la nueva clave" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="2428.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 5&lt;/font&gt;&lt;/b&gt;&lt;br&gt;T08 · Nueva contraseña / Contraseña actualizada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2660.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c45" value="Toca «Iniciar sesión» y entra" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="3008.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 6&lt;/font&gt;&lt;/b&gt;&lt;br&gt;G10 · Inicio" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="3240.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c47" value="Meta cumplida: recupera su acceso por su cuenta y llega a su Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="3820.0" y="869.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c48" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="989.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c49" value="¿Credenciales correctas?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="410.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c50" value="¿El correo existe?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="1570.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c51" value="¿Enlace vigente?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="2150.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Correo o contraseña incorrectos (US02 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="340.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c53" value="T03 · Iniciar sesión / Credenciales inválidas" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="340.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c54" value="Mensaje genérico sin revelar qué dato falló; reintenta o recupera la clave" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="340.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; El correo no tiene cuenta (US05 esc. 4)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c56" value="Se muestra el mismo mensaje neutral de T07; no se envía ningún enlace" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1842.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; El enlace ya venció o ya se usó (US05 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c58" value="T09 · Enlace no válido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c59" value="Toca «Solicitar nuevo enlace» y vuelve a T06 (PASO 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>