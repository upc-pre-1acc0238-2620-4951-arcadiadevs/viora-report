0" y="660.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="3240.0" y="660.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2946.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2946.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1842.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="3240.0" y="1842.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c35" value="UF-F12 · Muestrear el cuajado sin conexión" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=84;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="110.0" width="4080.0" height="110" as="geometry"/></mxCell><mxCell id="c36" value="Teodoro Mamani · Productor olivarero · App Productor (Kotlin) · US24, US25" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=32;fontColor=#A8A49C;" vertex="1" parent="1"><mxGeometry x="110.0" y="222.0" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c37" value="USER GOAL · F12" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c38" value="«Quiero contar brotes y frutos árbol por árbol en el campo, aunque no tenga señal, y que se envíe solo cuando vuelva la cobertura.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="4080.0" height="110" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P50 · Bitácora" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Toca «+» y elige «Muestreo de cuajado»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P51 · Nuevo muestreo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c42" value="Elige el lote y toca «Continuar ronda»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P52 · Ronda de muestreo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c44" value="Toca «Agregar árbol»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P53 · Registrar árbol" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c46" value="Anota brotes y frutos; guarda (repite hasta 5 árboles)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="2428.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 5&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P52 · Ronda de muestreo / Muestra suficiente" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2660.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c48" value="Toca «Finalizar ronda»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="3008.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 6&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P54 · Resumen de ronda" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="3240.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c50" value="Meta cumplida: muestra registrada y sincronizada; se habilita el plan del lote (UF-F13)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="3820.0" y="869.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c51" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="989.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c52" value="¿Hay señal?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="1570.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c53" value="¿Conteo válido?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="2150.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c54" value="¿Se sincronizó?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="3310.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Sin conexión en el campo (US24 esc. 1)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2808.0" width="910.0" height="116.0" as="geometry"/></mxCell><mxCell id="c56" value="P52 · Ronda de muestreo / Sin conexión" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="3666.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c57" value="P52 · Ronda de muestreo / Conexión recuperada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="3666.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c58" value="Cada árbol queda «Por sincronizar» y se envía solo al volver la señal (US24 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="3714.0" width="910.0" height="136.0" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Frutos por brote fuera del rango (US24 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c60" value="P53 · Registrar árbol / Conteo fuera de rango" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c61" value="Error en el campo con el rango admitido; corrige y guarda" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Finaliza la ronda sin señal" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="3240.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c63" value="P54 · Resumen de ronda / Guardada sin señal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="3240.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c64" value="Queda en el teléfono; se completa y habilita el plan al sincronizar" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mx