rent="1"><mxGeometry x="2660.0" y="1802.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2906.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2906.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1802.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1802.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c33" value="UF-F13 · Aclarear a tiempo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=84;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="110.0" width="2920.0" height="110" as="geometry"/></mxCell><mxCell id="c34" value="Teodoro Mamani · Productor olivarero · App Productor (Kotlin) · US26, US27, US28" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=32;fontColor=#A8A49C;" vertex="1" parent="1"><mxGeometry x="110.0" y="222.0" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c35" value="USER GOAL · F13" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c36" value="«Quiero saber cuánta fruta debo quitar y hasta qué fecha, y dejar registrado lo que hice.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="2920.0" height="110" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P60 · Plan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c38" value="Toca «La Yarada 02»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P61 · Plan del lote" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Toca «Registrar aclareo»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P62 · Registrar aclareo" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c42" value="Confirma fecha y porcentaje; toca «Guardar aclareo»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P63 · Aclareo registrado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c44" value="Meta cumplida: sabe cuánto quitar y hasta cuándo, y su aclareo queda en la Bitácora" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="2660.0" y="829.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c45" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="949.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c46" value="¿Hay prescripción vigente?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="990.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c47" value="¿Dentro de la ventana?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="1570.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c48" value="¿Se puede estimar el calibre?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="2150.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Faltan árboles en la muestra (US26 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c50" value="P61 · Plan del lote / Muestra incompleta" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c51" value="No calcula la carga; indica cuántos faltan y lleva al muestreo (UF-F12)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; La carga ya es óptima (US27 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2660.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c53" value="P61 · Plan del lote / Carga óptima" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c54" value="Prescripción de 0 %: no hace falta aclarear" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; El carozo ya endureció (US27 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="2768.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c56" value="P61 · Plan del lote / Ventana concluida" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="3626.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c57" value="Advierte el efecto sobre la floración siguiente" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="3674.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Sin conexión" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2768.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c59" value="P61 · Plan del lote / Sin conexión" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="3626.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c60" value="Muestra la última prescripción con su fecha, nunca como recién calculada" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2660.0" y="3674.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Registra el aclareo fuera de la ventana (US28 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c62" value="P62 · Registrar aclareo / Fuera de ventana" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c63" value="Se guarda igual, con advertencia de eficacia reducida" style="html=