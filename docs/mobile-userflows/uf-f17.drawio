mxCell><mxCell id="c53" value="No se puede revocar" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Pide más códigos que plazas libres (TS08 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c55" value="G43 · Generar códigos / Cupo excedido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c56" value="El botón se deshabilita" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>