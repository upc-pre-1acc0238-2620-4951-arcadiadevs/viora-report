ext;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c23" value="«Quiero estimar cuántas toneladas de aceituna verde y negra entregarán los socios para planificar la planta y los contratos.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="2340.0" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;G10 · Inicio" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c25" value="Toca la tarjeta «Acopio»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;G30 · Acopio" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c27" value="Toca el selector «Campaña 2026»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;G30 · Elegir campaña (hoja)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Meta cumplida: conoce las toneladas proyectadas de verde y negra y la cobertura que las respalda" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="2080.0" y="869.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c30" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="989.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c31" value="¿Hay datos suficientes?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="990.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Cobertura menor al 50 % (US32 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c33" value="G30 · Preliminar (cobertura &amp;lt; 50 %)" style="te