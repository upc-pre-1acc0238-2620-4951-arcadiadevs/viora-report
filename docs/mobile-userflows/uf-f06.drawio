2A2410;" vertex="1" parent="1"><mxGeometry x="2150.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c67" value="¿Cabe en su plan?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="2730.0" y="1469.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Está sin GPS o desde casa: elige «Trazar en el mapa»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c69" value="P23 · Trazar en el mapa" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c70" value="Centra cada esquina bajo la mira y continúa en P24" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Negó el permiso de ubicación" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="3240.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c72" value="P21 · Método / Sin permiso de ubicación" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="3240.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c73" value="La tarjeta GPS se bloquea; puede volver a pedir el permiso o trazar en el mapa" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="3240.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Error mayor a 15 m" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c75" value="P22 · Delimitar con GPS / Señal débil" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c76" value="No deja marcar la esquina; pasados 30 m ofrece seguir en el mapa" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Se pierde la señal GPS (US09 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="3820.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c78" value="P22 · Sin señal GPS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="3820.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c79" value="Conserva las esquinas y ofrece seguir en el mapa (P23)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="3820.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Menos de 3 esquinas (US09 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2808.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c81" value="P22 · Contorno abierto (2 esquinas)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="3666.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c82" value="«Cerrar contorno» deshabilitado y explica por qué" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="3714.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Los bordes se cruzan (US09 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="3240.0" y="2808.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c84" value="P22 · Bordes que se cruzan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="3240.0" y="3666.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c85" value="No cierra hasta corregir la esquina indicada" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="3240.0" y="3714.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Densidad mayor a 500 árboles/ha" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c87" value="P24 · Marco fuera de rango" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c88" value="Error en el campo; no calcula ni avanza hasta corregir el marco" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Sale a mitad con ×" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2808.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c90" value="P24 · ¿Descartar este lote?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="3666.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c91" value="Confirma antes de perder esquinas y datos; «Seguir editando» vuelve a P24" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="3714.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; El área supera las hectáreas del plan" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2660.0" y="1704.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c93" value="P25 · Área mayor al cupo del plan" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2562.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c94" value="Ajusta el contorno (vuelve a P22) o amplía su plan" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2610.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>