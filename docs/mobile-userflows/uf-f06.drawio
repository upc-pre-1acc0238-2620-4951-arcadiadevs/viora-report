t;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P22 · Delimitar con GPS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c56" value="Marca las esquinas y toca «Cerrar contorno»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P24 · Caracterización" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c58" value="Completa nombre, variedad y marco; toca «Revisar lote»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="2428.0" y="935.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 5&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P25 · Revisar y guardar" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2660.0" y="548.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c60" value="Toca «Guardar lote»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontC