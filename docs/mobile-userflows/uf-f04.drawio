l><mxCell id="c30" value="Teodoro Mamani · Productor olivarero · App Productor (Kotlin) · US06, US07" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=32;fontColor=#A8A49C;" vertex="1" parent="1"><mxGeometry x="110.0" y="222.0" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c31" value="USER GOAL · F04" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c32" value="«Quiero habilitar Viora pagando mi plan o con el código que me dio mi cooperativa.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="2920.0" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P02 · Plan Productor" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c34" value="Toca «Pagar con Mercado Pago» y paga en Checkout Pro" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P04 · Resultado del pago / Verificando" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c36" value="Mercado Pago confirma el pago al servidor" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=none;strokeColor=#E8B923;dashed=1;strokeWidth=3;fontColor=#E8B923;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P04 · Resultado del pago / Aprobado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c38" value="Toca «Ir al inicio»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P10 · Inicio / Sin lotes" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Meta cumplida: acceso activo; Teodoro entra a su Inicio para registrar su primer lote" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="2660.0" y="829.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c41" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="949.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c42" value="¿Tiene código de cooperativa?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="410.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c43" value="¿Pago aprobado?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="990.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Toca «Tengo un código», lo escribe y lo canjea (US07 esc. 1)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1664.0" width="1490.0" height="116.0" as="geometry"/></mxCell><mxCell id="c45" value="P05 · Canjear código" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c46" value="P05 · Canjear código / Validando" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c47" value="P06 · Membresía activada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c48" value="La cooperativa cubre su plan; toca «Ir al inicio» y llega al PASO 4" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2570.0" width="1490.0" height="136.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; El código no existe, venció o ya se canjeó (US07 esc. 2–3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="340.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c50" value="P05 · Canjear código / Código no válido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="340.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c51" value="Prueba otro código o vuelve a pagar su plan en P02" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="340.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Mercado Pago rechaza el pago (US06 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c53" value="P04 · Resultado del pago / Rechazado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c54" value="Sin suscripción ni cargos; reintenta el pago o usa un código" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>