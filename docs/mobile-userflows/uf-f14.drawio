oductor olivarero · App Productor (Kotlin) · US29, US30" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=32;fontColor=#A8A49C;" vertex="1" parent="1"><mxGeometry x="110.0" y="222.0" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c45" value="USER GOAL · F14" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c46" value="«Quiero registrar los kilos cosechados, cerrar la campaña y descargar el expediente de mi lote.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="2650.0" height="110" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P10 · Inicio / Fase · Cosecha" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c48" value="Toca «Registrar cosecha»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P70 · ¿Qué lote cosechaste? (hoja)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometr