984.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c116" value="T04 · Crear cuenta / Contraseña débil" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="3240.0" y="4842.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c117" value="Los criterios se validan al escribir; el botón se habilita al cumplirlos" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="3240.0" y="4890.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c118" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Código incorrecto" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2660.0" y="3984.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c119" value="T04a · Verifica tu correo / Código incorrecto" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="4842.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c120" value="Reintenta; tras 3 intentos fallidos se bloquea 10 min y ofrece reenviar el código" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2660.0" y="4890.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>