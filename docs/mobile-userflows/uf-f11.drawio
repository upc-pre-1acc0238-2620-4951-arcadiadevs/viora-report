,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="1802.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;image=data:image/jpeg,;imageBorder=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2906.0" width="330.0" height="718.0" as="geometry"/></mxCell><mxCell id="c24" value="UF-F11 · Seguir el frío invernal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=84;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="110.0" width="2340.0" height="110" as="geometry"/></mxCell><mxCell id="c25" value="Teodoro Mamani · Productor olivarero · App Productor (Kotlin) · US22, US23" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=32;fontColor=#A8A49C;" vertex="1" parent="1"><mxGeometry x="110.0" y="222.0" width="2400" height="50" as="geometry"/></mxCell><mxCell id="c26" value="USER GOAL · F11" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontSize=26;fontStyle=1;fontColor=#E8B923;" vertex="1" parent="1"><mxGeometry x="110.0" y="284.0" width="600" height="36" as="geometry"/></mxCell><mxCell id="c27" value="«Quiero saber cuánto frío ha acumulado mi olivar este invierno para anticipar cómo será la floración.»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;fontFamily=Newsreader;fontSize=44;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="110.0" y="328.0" width="2340.0" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P10 · Inicio / Fase · Reposo invernal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="340.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Toca «Ver mi frío» en la tarjeta de fase" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P80 · Frío invernal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Toca «¿Qué es?»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P81 · ¿Por qué cuento frío? (hoja)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c33" value="Meta cumplida: sabe cuánto frío acumuló su olivar y qué esperar de la floración" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="2080.0" y="829.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c34" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="949.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c35" value="¿Hubo un pico cálido?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="410.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c36" value="¿En qué momento del invierno?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="990.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Más de 3 días seguidos sobre 24 °C (US23)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1664.0" width="910.0" height="116.0" as="geometry"/></mxCell><mxCell id="c38" value="T15 · Invierno cálido (alerta)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c39" value="P80 · Frío invernal / Frío frenado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c40" value="Ve las porciones que no se formaron y la nueva proyección" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2570.0" width="910.0" height="136.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Llega a 30 porciones (US22 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c42" value="P80 · Frío invernal / Estímulo completado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c43" value="Cambia el estado y Viora avisa con una notificación" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Fuera del invierno (US22 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="2768.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c45" value="P80 · Frío invernal / Fuera de temporada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="3626.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c46" value="El conteo está en pausa y muestra el cierre del invierno pasado" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="3674.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>