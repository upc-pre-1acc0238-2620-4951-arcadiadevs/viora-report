="1" parent="1"><mxGeometry x="340.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c36" value="Toca «Más opciones»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="688.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P27 · Opciones del lote (hoja)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="920.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c38" value="Toca «Editar datos del lote»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1268.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P28 · Editar lote" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="1500.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Cambia el marco y toca «Guardar cambios»" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=4;fillColor=#CFE3C1;strokeColor=none;fontColor=#1F2B1E;fontSize=23;" vertex="1" parent="1"><mxGeometry x="1848.0" y="895.0" width="214.0" height="168.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;&lt;font color=&quot;#E8B923&quot;&gt;PASO 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;P26 · Detalle del lote (recién guardado)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;verticalAlign=top;fontSize=23;fontColor=#F3F0E8;" vertex="1" parent="1"><mxGeometry x="2080.0" y="508.0" width="550.0" height="70" as="geometry"/></mxCell><mxCell id="c42" value="Meta cumplida: lote corregido con densidad y área recalculadas" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=3;fillColor=none;strokeColor=#E8B923;strokeWidth=3;fontColor=#E8B923;fontSize=27;" vertex="1" parent="1"><mxGeometry x="2660.0" y="829.0" width="330.0" height="300.0" as="geometry"/></mxCell><mxCell id="c43" value="Inicio" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;rounded=1;arcSize=50;fillColor=none;strokeColor=#F3F0E8;strokeWidth=3;fontColor=#F3F0E8;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110.0" y="949.0" width="150" height="60" as="geometry"/></mxCell><mxCell id="c44" value="¿Qué quiere hacer con el lote?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="990.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c45" value="¿Marco válido?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=21;fontStyle=1;fontColor=#2A2410;" vertex="1" parent="1"><mxGeometry x="1570.0" y="1429.0" width="190.0" height="90.0" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Corregir el contorno (US10 esc. 1)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c47" value="P29 · Ajustar el contorno" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c48" value="Mover una esquina recalcula la superficie y conserva el historial" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Retirar un lote con historial (US11 esc. 2)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="2080.0" y="1664.0" width="910.0" height="116.0" as="geometry"/></mxCell><mxCell id="c50" value="P28 · Archivar lote con historial (diálogo)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c51" value="P20 · Lotes / Archivados" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="2660.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c52" value="Se archiva con su trazabilidad y se puede restaurar" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="2080.0" y="2570.0" width="910.0" height="136.0" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Retirar un lote sin cosechas ni lecturas (US11 esc. 1)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="920.0" y="2768.0" width="910.0" height="116.0" as="geometry"/></mxCell><mxCell id="c54" value="P28 · Eliminar lote (diálogo)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="920.0" y="3626.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c55" value="P20 · Lotes / Lote eliminado" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="3626.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c56" value="Sale del inventario y libera sus hectáreas del plan" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="920.0" y="3674.0" width="910.0" height="136.0" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;&lt;font color=&quot;#E2774F&quot;&gt;SI&lt;/font&gt;&lt;/b&gt; Densidad mayor a 500 árboles/ha (US10 esc. 3)" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=#3D2C25;strokeColor=#E2774F;strokeWidth=3;fontColor=#F3F0E8;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1500.0" y="1664.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c58" value="P28 · Editar lote / Marco fuera de rango" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;fontSize=20;fontColor=#E2774F;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2522.0" width="330.0" height="30" as="geometry"/></mxCell><mxCell id="c59" value="No se guarda; muestra los rangos admitidos" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Roboto;align=left;spacingLeft=14;rounded=1;arcSize=4;fillColor=none;strokeColor=#E2774F;dashed=1;strokeWidth=3;fontColor=#F3F0E8;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1500.0" y="2570.0" width="330.0" height="136.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>