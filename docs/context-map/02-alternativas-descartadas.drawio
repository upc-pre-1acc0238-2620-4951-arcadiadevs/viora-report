        </mxCell>

        <mxCell id="a_bc2" value="&lt;b&gt;Phenology &amp;amp; Historical&lt;br&gt;Bearing Analytics&lt;/b&gt;&lt;br&gt;&lt;i&gt;Core&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a_sk" value="&lt;b&gt;SHARED KERNEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;AgronomicReport&lt;br&gt;HistoricalHarvestEntry&lt;br&gt;BiennialBearingIndex" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a_bc3" value="&lt;b&gt;Harvest Settlement &amp;amp;&lt;br&gt;Performance Reporting&lt;/b&gt;&lt;br&gt;&lt;i&gt;Core&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="160" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a_e1" value="SK" style="endArrow=none;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="a_bc2" target="a_sk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_e2" value="SK" style="endArrow=none;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="a_sk" target="a_bc3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_note" value="&lt;b&gt;Por qué se descartó&lt;/b&gt;&lt;br&gt;&lt;br&gt;• El solapamiento que sugería un Shared Kernel resultó ser un &lt;b&gt;defecto de documentación&lt;/b&gt;, no una decisión de diseño: el paso de agregados había absorbido en AgronomicReport contenido que pertenece a Phenology. No se modela un patrón sobre un error.&lt;br&gt;&lt;br&gt;• El Shared Kernel es el patrón de &lt;b&gt;mayor acoplamiento&lt;/b&gt; del catálogo. Obliga a los dos contextos a coordinar cada cambio del modelo compartido, incluido cualquier ajuste de la fórmula del BBI.&lt;br&gt;&lt;br&gt;• Separado el agregado, la dependencia mutua real se expresa como &lt;b&gt;Partnership&lt;/b&gt;: ambos contextos colaboran sin co-poseer el modelo, que es el acoplamiento mínimo que resuelve el problema." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="130" width="500" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="h2" value="&lt;b&gt;ALTERNATIVA B&lt;/b&gt; — Cooperative Operations como Conformist de sus cuatro upstream" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="750" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="sep2" value="" style="line;strokeWidth=1;html=1;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="435" width="1400" height="10" as="geometry"/>
        </mxCell>

