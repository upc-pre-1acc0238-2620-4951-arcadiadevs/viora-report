          <mxGeometry x="60" y="735" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b_bc6" value="&lt;b&gt;Cooperative Operations &amp;amp;&lt;br&gt;Territorial Intelligence&lt;/b&gt;&lt;br&gt;&lt;i&gt;Supporting&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="605" width="220" height="85" as="geometry"/>
