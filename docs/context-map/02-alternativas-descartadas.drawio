<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Alternativas descartadas" id="viora-context-map-alternatives">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Viora — Context Map: alternativas evaluadas y descartadas&lt;/b&gt;&lt;br&gt;&lt;i&gt;Diseños candidatos considerados durante la elaboración del mapa recomendado&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="&lt;b&gt;ALTERNATIVA A&lt;/b&gt; — Shared Kernel entre Phenology y Harvest Settlement" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="700" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="sep1" value="" style="line;strokeWidth=1;html=1;strokeColor=#B85450;" vertex="1" parent="1">
