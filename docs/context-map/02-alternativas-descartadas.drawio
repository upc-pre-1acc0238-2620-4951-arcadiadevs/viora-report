        <mxCell id="b_e1" value="CF" style="endArrow=blockThin;html=1;fontSize=11;fontStyle=1;endFill=1;" edge="1" parent="1" source="b_bc8" target="b_bc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b_e2" value="CF" style="endArrow=blockThin;html=1;fontSize=11;fontStyle=1;endFill=1;" edge="1" parent="1" source="b_bc7" target="b_bc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b_e3" value="CF" style="endArrow=blockThin;html=1;fontSize=11;fontStyle=1;endFill=1;" edge="1" parent="1" source="b_bc1" target="b_bc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b_e4" value="CF" style="endArrow=blockThin;html=1;fontSize=11;fontStyle=1;endFill=1;" edge="1" parent="1" source="b_bc5" target="b_bc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="b_note" value="&lt;b&gt;Por qué se descartó&lt;/b&gt;&lt;br&gt;&lt;br&gt;La hipótesis era razonable: Cooperative Operations es un subdominio de soporte que depende de dos contextos core, así que podría carecer de poder para negociar el contrato y limitarse a aceptar lo que recibe.&lt;br&gt;&lt;br&gt;&lt;b&gt;La evidencia del canvas la refuta.&lt;/b&gt; El criterio que separa Conformist de Customer/Supplier es si el downstream adopta el lenguaje del upstream o conserva el propio. El Ubiquitous Language de Cooperative Operations —&lt;i&gt;Cooperative, CorporateLicensingPlan, CooperativeMember, InvitationCode, TerritorialRiskMatrix, EarlyIntakeProjection&lt;/i&gt;— no toma prestado ni un término de sus cuatro upstream.&lt;br&gt;&lt;br&gt;Un Conformist adopta el modelo ajeno tal cual. Este contexto hace lo contrario: &lt;b&gt;traduce cuatro vocabularios distintos&lt;/b&gt; a su propio modelo territorial. Se mantiene entonces &lt;b&gt;Customer/Supplier&lt;/b&gt; en las cuatro relaciones." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="465" width="500" height="330" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
